# ==========================================================
# Upstage API (Upstage Console에서 발급)
# ==========================================================

UPSTAGE_API_KEY=


# ==========================================================
# Studio 에이전트 (Studio → 에이전트 → API로 이용하기에서 복사)
# NPOS 팀이 내보낸 설정의 workflowId:
#   Contract Agent  agt_HfBnMxGZ3q2HmxNt7kXyDy
#   Criteria Agent  agt_4GJMgpjwGtoHseqQS96mhj
#   Review Agent    agt_LVnts4GUpLXZ9GmCCjGn6p
# API Key는 이 에이전트들이 있는 워크스페이스의 키여야 합니다.
# ==========================================================

CONTRACT_AGENT_ID=
CONTRACT_CONFIG_ID=1

CRITERIA_AGENT_ID=
CRITERIA_CONFIG_ID=1

REVIEW_AGENT_ID=
REVIEW_CONFIG_ID=1


# ==========================================================
# 선택
# ==========================================================

# 1이면 키가 있어도 데모 모드 (발표 중 요청 제한 대비, fixtures/live/ 재생)
FORCE_DEMO=0

# 에이전트 Job 하나를 기다리는 최대 시간(초)
AGENT_TIMEOUT_SECONDS=180
