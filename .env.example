# ==========================================================
# Upstage API (Upstage Console에서 발급)
# ==========================================================

UPSTAGE_API_KEY=


# ==========================================================
# Studio 에이전트 (Studio → 에이전트 → API로 이용하기 / 워크플로우 설정 내보내기)
# agent_configs/의 설정을 Studio에 "가져오기"로 만든 에이전트의 값을 넣는다.
# Agent ID는 agt_로, Config ID는 cfg_로 시작한다(API 화면에 버전 #1만 보이면
# 내보낸 JSON의 exportedFrom.configId 값을 쓴다).
# API Key는 이 에이전트들이 있는 조직의 키여야 한다.
# ==========================================================

CONTRACT_AGENT_ID=
CONTRACT_CONFIG_ID=

CRITERIA_AGENT_ID=
CRITERIA_CONFIG_ID=

REVIEW_AGENT_ID=
REVIEW_CONFIG_ID=


# ==========================================================
# 선택
# ==========================================================

# 1이면 키가 있어도 데모 모드 (발표 중 요청 제한 대비, fixtures/live/ 재생)
FORCE_DEMO=0

# 에이전트 Job 하나를 기다리는 최대 시간(초). Review Agent는 3분 넘게 걸릴 수 있다
AGENT_TIMEOUT_SECONDS=420

# HTTP 요청 하나의 최대 시간(초)
HTTP_TIMEOUT_SECONDS=60
