    "informationExtractConfiguration": {
      "modelName": "",
      "schemas": [
        {
          "type": "json_schema",
          "json_schema": {
            "name": "contract_info",
            "schema": {
              "type": "object",
              "properties": {
                "employer_name": {
                  "type": "string",
                  "description": "계약서 상단의 당사자 표기 또는 서명란에서 사업주(사용자)의 상호 또는 성명을 추출한다. 사업장 상호와 대표자 성명이 함께 있으면 상호를 쓴다. 값이 없으면 빈 문자열로 둔다."
                },
                "employee_name": {
                  "type": "string",
                  "description": "계약서 상단의 당사자 표기 또는 서명란에서 근로자 성명을 추출한다. '근로자' 또는 '을'로 표시된 쪽의 이름을 쓴다. 값이 없으면 빈 문자열로 둔다."
                },
                "contract_start_date": {
                  "type": "string",
                  "description": "'근로개시일', '근로계약기간', '계약기간' 항목의 시작일을 추출한다. 문서에 적힌 형식을 그대로 쓰되 연도가 있으면 YYYY-MM-DD로 맞춘다. 값이 없으면 빈 문자열로 둔다."
                },
                "contract_end_date": {
                  "type": "string",
                  "description": "'계약기간' 항목의 종료일을 추출한다. 기간의 정함이 없는 근로계약이거나 값이 없으면 빈 문자열로 둔다."
                },
                "workplace": {
                  "type": "string",
                  "description": "'근무장소' 항목에 적힌 주소 또는 장소명을 추출한다. 없으면 빈 문자열로 둔다."
                },
                "job_description": {
                  "type": "string",
                  "description": "'업무의 내용' 항목에 적힌 업무를 추출한다. 여러 업무가 나열되어 있으면 한 문자열로 자연스럽게 합친다. 없으면 빈 문자열로 둔다."
                },
                "work_days": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "'근무일', '근무요일', '소정근로일' 항목에 적힌 요일을 요일마다 한 항목으로 추출한다. '월~금'처럼 범위로 적혀 있으면 월, 화, 수, 목, 금으로 펼친다. 요일 없이 '주 5일 (요일은 협의)'처럼 일수만 적혀 있으면 그 문구를 그대로 한 항목으로 쓴다. 없으면 빈 목록으로 둔다."
                  },
                  "description": "work days"
                },
                "work_start_time": {
                  "type": "string",
                  "description": "'소정근로시간' 항목의 시작 시각을 추출한다(예: 09:00). 없으면 빈 문자열로 둔다."
                },
                "work_end_time": {
                  "type": "string",
                  "description": "'소정근로시간' 항목의 종료 시각을 추출한다(예: 18:00). 없으면 빈 문자열로 둔다."
                },
                "break_time": {
                  "type": "string",
                  "description": "'휴게시간' 항목에 적힌 시간을 추출한다(예: 12:00~13:00 또는 1시간). 적혀 있지 않으면 비워 둔다."
                },
                "weekly_holiday": {
                  "type": "string",
                  "description": "'주휴일' 또는 '휴일' 항목에 적힌 요일이나 문구를 추출한다. 없으면 빈 문자열로 둔다."
                },
                "wage_type": {
                  "type": "string",
                  "description": "'임금' 항목의 구분(시급, 일급, 월급)을 추출한다. 금액 옆에 단위로 적혀 있으면 그 단위를 쓴다. 없으면 빈 문자열로 둔다."
                },
                "wage_amount": {
                  "type": "number",
                  "description": "'임금' 항목의 금액을 원 단위 숫자로 추출한다. 쉼표와 '원' 글자는 제외하고 숫자만 쓴다. 시급, 일급, 월급 중 어느 금액인지 구분해 해당 금액만 쓴다. 값이 없으면 비워 둔다."
                },
                "wage_payment_date": {
                  "type": "string",
                  "description": "'임금지급일' 항목을 추출한다(예: 매월 10일). 없으면 빈 문자열로 둔다."
                },
                "wage_payment_method": {
                  "type": "string",
                  "description": "임금 '지급방법' 항목을 추출한다(예: 계좌이체, 현금). 없으면 빈 문자열로 둔다."
                },
                "annual_leave_clause": {
                  "type": "string",
                  "description": "연차유급휴가 관련 문구를 원문 그대로 추출한다. '연차', '유급휴가', '연차휴가'가 포함된 문장이나 조항을 쓴다. 없으면 빈 문자열로 둔다."
                },
                "social_insurance": {
                  "type": "string",
                  "description": "'사회보험 적용 여부' 항목 또는 고용보험, 산재보험, 국민연금, 건강보험 관련 문구를 추출한다. 없으면 빈 문자열로 둔다."
                },
                "copy_delivery_clause": {
                  "type": "string",
                  "description": "계약서 교부 관련 문구를 추출한다. 계약서 하단이나 말미의 '근로계약서를 교부한다' 같은 안내 문구를 쓴다. 없으면 빈 문자열로 둔다."
                },
                "special_terms": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "특약사항, 기타 조항, 비고란에서 위약금, 손해배상액 예정, 임금 감액, 퇴사 제한처럼 근로자에게 불리할 수 있는 조항을 원문 그대로 항목마다 하나씩 추출한다. 해당하는 조항이 없으면 빈 목록으로 둔다."
                  },
                  "description": "special terms"
                },
                "is_signed": {
                  "type": "boolean",
                  "description": "서명란에 사업주와 근로자의 서명 또는 날인이 모두 있는지 본다. 두 사람의 서명이 모두 확인되면 true, 하나라도 없거나 서명란이 비어 있으면 false로 둔다. 서명란을 찾을 수 없으면 false로 둔다."
                }
              }
            }
          },
